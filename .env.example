# ==========================================
# AUTO-INCOME AI - EXEMPLE DE CONFIGURATION ENVIRONNEMENT
# Aucun secret ou clé obligatoire n'est requis pour le fonctionnement de base (0$ de budget).
# ==========================================

# Mode Simulation (1 = simulation sans requêtes réseau externes, 0 = mode production en ligne)
SIMULATION_MODE=0

# Emplacement de la base SQLite et de l'export d'état
STORAGE_DB_PATH=data/income_ai.db
STATE_JSON_PATH=data/state.json

# Clé API Google Gemini (OPTIONNELLE - quota gratuit disponible pour enrichir les contenus)
# Laissez vide pour utiliser le moteur de génération heuristique local autonome
GEMINI_API_KEY=

# Clé Hugging Face (OPTIONNELLE)
HF_TOKEN=

# Identifiants de paiement (OPTIONNELS - pour la génération des liens marchands réels)
# Votre identifiant ou nom d'utilisateur Gumroad (ex: monprofil)
GUMROAD_USERNAME=
# Votre lien Ko-fi (ex: https://ko-fi.com/monprofil)
KOFI_URL=
# Votre adresse USDT TRC20 pour recevoir les micro-paiements directs
CRYPTO_USDT_TRC20_ADDRESS=
# Votre identifiant Payoneer ou email associé
PAYONEER_EMAIL=
